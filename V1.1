# ============================================================
# Gráficos e quartis – continuação (requer o objeto 'dados')
# install.packages(c("ggplot2","patchwork"))
# ============================================================
library(ggplot2)
library(patchwork)

cores <- c(TP = "#1f77b4", TM = "#ff7f0e", TC = "#2ca02c", TPC = "#9467bd")
tema  <- theme_bw(base_size = 12) +
  theme(legend.position = "none", panel.grid.minor = element_blank())

# ---- 1. Tabela de quartis por tratamento ----
quartis <- dados %>%
  select(trat, all_of(names(vars))) %>%
  pivot_longer(-trat, names_to = "variavel") %>%
  group_by(variavel, trat) %>%
  summarise(Min = min(value), Q1 = quantile(value, 0.25),
            Mediana = median(value), Q3 = quantile(value, 0.75),
            Max = max(value), IIQ = IQR(value), .groups = "drop") %>%
  mutate(across(Min:IIQ, ~ round(.x, 2)),
         variavel = vars[variavel])
print(quartis, n = Inf)
# write.csv2(quartis, "quartis_balanco_carbono.csv", row.names = FALSE)

# ---- 2. Boxplots (quartis) + pontos dos viveiros (dispersão) ----
box_var <- function(v, titulo, ylab = "kg C ha-1") {
  p_val <- tabela$p_ANOVA[tabela$Variavel == vars[[v]]]
  ggplot(dados, aes(trat, .data[[v]], fill = trat)) +
    geom_boxplot(alpha = 0.35, width = 0.6, outlier.shape = NA) +
    geom_jitter(aes(color = trat), width = 0.08, size = 2.8) +
    stat_summary(fun = mean, geom = "point", shape = 4, size = 3.5, stroke = 1.2) +
    scale_fill_manual(values = cores) + scale_color_manual(values = cores) +
    labs(title = titulo, subtitle = sprintf("ANOVA p = %.3f", p_val),
         x = NULL, y = ylab) + tema
}

g_box <- box_var("racao", "Ração") +
  box_var("biomassa", "Biomassa despescada") +
  box_var("til", "Tilápia despescada") +
  box_var("sedimento", "Sedimento") +
  box_var("gases", "Gases (líquido)") +
  box_var("agua_sai", "Água de saída") +
  box_var("nao_contab", "Não contabilizado", "% das entradas") +
  box_var("retencao", "Retenção da ração", "%") +
  plot_layout(ncol = 4)
print(g_box)
ggsave("boxplots_balanco.png", g_box, width = 16, height = 8, dpi = 300)

# ---- 3. Gráficos de dispersão (relações entre componentes) ----
disp <- function(x, y, xl, yl) {
  ct <- cor.test(dados[[x]], dados[[y]])
  ggplot(dados, aes(.data[[x]], .data[[y]])) +
    geom_smooth(method = "lm", se = TRUE, color = "grey40", linewidth = 0.7) +
    geom_point(aes(color = trat), size = 3) +
    geom_text(aes(label = paste0("V", viveiro)), vjust = -0.9, size = 3) +
    scale_color_manual(values = cores, name = "Tratamento") +
    labs(x = xl, y = yl,
         subtitle = sprintf("r = %.2f; p = %.3f", ct$estimate, ct$p.value)) +
    theme_bw(base_size = 12)
}

g_disp <- disp("gases", "nao_contab", "Gases (kg C ha-1)", "Não contabilizado (%)") +
  disp("racao", "biomassa", "C ração (kg C ha-1)", "Biomassa despescada (kg C ha-1)") +
  disp("sedimento", "nao_contab", "Sedimento (kg C ha-1)", "Não contabilizado (%)") +
  disp("racao", "sedimento", "C ração (kg C ha-1)", "Sedimento (kg C ha-1)") +
  plot_layout(ncol = 2, guides = "collect")
print(g_disp)
ggsave("dispersao_balanco.png", g_disp, width = 12, height = 9, dpi = 300)

# ---- 4. Destino do carbono (% das entradas) por tratamento ----
destino <- dados %>%
  mutate(Biomassa = biomassa / entradas * 100,
         Sedimento = sedimento / entradas * 100,
         Gases = gases / entradas * 100,
         `Água de saída` = agua_sai / entradas * 100,
         `Não contabilizado` = nao_contab) %>%
  select(trat, Biomassa:`Não contabilizado`) %>%
  pivot_longer(-trat, names_to = "Compartimento") %>%
  group_by(trat, Compartimento) %>%
  summarise(pct = mean(value), .groups = "drop") %>%
  mutate(Compartimento = factor(Compartimento,
                                levels = c("Não contabilizado", "Água de saída", "Gases",
                                           "Sedimento", "Biomassa")))

g_dest <- ggplot(destino, aes(trat, pct, fill = Compartimento)) +
  geom_col(width = 0.65, color = "white") +
  geom_text(aes(label = sprintf("%.1f%%", pct)),
            position = position_stack(vjust = 0.5), size = 3.3) +
  scale_fill_brewer(palette = "Set2") +
  labs(x = NULL, y = "% das entradas de carbono",
       title = "Destino do carbono por tratamento") +
  theme_bw(base_size = 12)
print(g_dest)
ggsave("destino_carbono.png", g_dest, width = 8, height = 6, dpi = 300)
