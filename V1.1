# ============================================================
# Balanço de carbono – ANOVA por tratamento (kg C ha-1 ciclo-1)
# Dados: aba BALANÇO (linhas 48–59), 12 viveiros, n = 3 por tratamento
# TP = tilápia+camarão | TM = tilápia mono | TC = tilápia+curimbatá
# TPC = tilápia+camarão+curimbatá
# ============================================================

# Pacotes (instale uma vez: install.packages(c("car","dplyr","tidyr")))
library(car)    # leveneTest
library(dplyr)
library(tidyr)

dados <- read.table(header = TRUE, text = "
viveiro trat racao agua_ent est_til est_cur est_cam til cur cam sedimento gases agua_sai
7  TP  11581.32 130.92 8.42  0.00 0.23 1290.43   0.00 142.08 2167.33   813.23 177.36
8  TPC 11416.12 127.24 8.41 73.30 0.23 1146.68 199.94 120.34 1790.91  -360.20 154.39
9  TM  11530.44  95.77 8.41  0.00 0.00 1303.72   0.00   0.00 2044.75   184.30 240.03
10 TPC 10864.02 109.10 8.41 73.30 0.23 1051.03 129.13  34.45 1632.23  1329.18 153.61
11 TP  11238.89  85.79 8.41  0.00 0.23 1366.26   0.00 101.04 2042.31   960.19 128.80
12 TPC 11314.46  61.95 8.41 73.30 0.23 1121.52 126.77  77.53 1508.59  -115.99  79.37
13 TM  10674.66  65.80 8.41  0.00 0.00 1404.22   0.00   0.00 1866.08   -78.07 145.47
14 TC  10211.89  56.92 8.41 73.30 0.00  921.63 160.99   0.00 2079.23   115.27 117.87
15 TC  10272.62  37.95 8.42 73.30 0.00 1054.96  98.14   0.00 1780.10  1869.58  69.55
16 TP  11489.61 104.72 8.42  0.00 0.23 1236.61   0.00  26.93 1530.16   448.25 163.88
17 TC  10762.97  69.19 8.42 73.30 0.00 1458.71 134.83   0.00 1601.24  1014.82 140.89
18 TM  12690.11  84.77 8.42  0.00 0.00 1241.68   0.00   0.00 1464.72  1079.65  56.18
")

dados$trat <- factor(dados$trat, levels = c("TP", "TM", "TC", "TPC"))

# ---- Variáveis derivadas ----
dados <- dados %>%
  mutate(
    entradas      = racao + agua_ent + est_til + est_cur + est_cam,
    biomassa      = til + cur + cam,
    saidas        = biomassa + sedimento + gases + agua_sai,
    entrada_saida = entradas - saidas,
    recuperacao   = saidas / entradas * 100,
    nao_contab    = 100 - recuperacao,
    ganho_liq     = biomassa - (est_til + est_cur + est_cam),
    retencao      = ganho_liq / racao * 100
  )

vars <- c(racao = "Ração", agua_ent = "Água de entrada",
          biomassa = "Biomassa despescada", til = "Tilápia despescada",
          sedimento = "Sedimento", gases = "Gases (líquido)",
          agua_sai = "Água de saída", entradas = "Total de entradas",
          nao_contab = "Não contabilizado (%)", entrada_saida = "Entrada − Saída",
          ganho_liq = "Ganho líquido biomassa", retencao = "Retenção da ração (%)")

# ---- Tabela-resumo: ANOVA + pressupostos + testes alternativos ----
resultado <- lapply(names(vars), function(v) {
  f   <- as.formula(paste(v, "~ trat"))
  m   <- aov(f, data = dados)
  a   <- summary(m)[[1]]
  sw  <- shapiro.test(residuals(m))
  lev <- leveneTest(f, data = dados, center = mean)
  kw  <- kruskal.test(f, data = dados)
  wel <- oneway.test(f, data = dados, var.equal = FALSE)
  med <- tapply(dados[[v]], dados$trat, mean)
  data.frame(
    Variavel   = vars[[v]],
    TP = round(med["TP"], 2), TM = round(med["TM"], 2),
    TC = round(med["TC"], 2), TPC = round(med["TPC"], 2),
    F          = round(a$`F value`[1], 3),
    p_ANOVA    = round(a$`Pr(>F)`[1], 4),
    W_Shapiro  = round(sw$statistic, 4),
    p_Shapiro  = round(sw$p.value, 4),
    p_Levene   = round(lev$`Pr(>F)`[1], 4),
    p_Welch    = round(wel$p.value, 4),
    p_Kruskal  = round(kw$p.value, 4),
    row.names  = NULL
  )
})
tabela <- do.call(rbind, resultado)
print(tabela, row.names = FALSE)

# ---- Tukey HSD: tilápia despescada ----
m_til <- aov(til ~ trat, data = dados)
print(TukeyHSD(m_til, conf.level = 0.95))

# ---- Média ± desvio-padrão por tratamento (formato das tabelas) ----
resumo <- dados %>%
  select(trat, all_of(names(vars))) %>%
  pivot_longer(-trat, names_to = "variavel") %>%
  group_by(variavel, trat) %>%
  summarise(media = mean(value), dp = sd(value), .groups = "drop") %>%
  mutate(texto = sprintf("%.1f ± %.1f", media, dp)) %>%
  select(variavel, trat, texto) %>%
  pivot_wider(names_from = trat, values_from = texto)
print(resumo, n = Inf)

